  "/design": {
   "post": {
    "summary": "Design",
    "description": "Calcula un caso de diseño completo.",
    "operationId": "design_design_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DesignRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DesignResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/design/plan": {
   "post": {
    "summary": "Design Plan",
    "description": "Plano SVG del caso: lámina técnica (``sheet``) o escala real (``scale``).",
    "operationId": "design_plan_design_plan_post",
    "parameters": [
     {
      "name": "view",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "sheet",
        "scale"
       ],
       "type": "string",
       "default": "sheet",
       "title": "View"
      }
     },
     {
      "name": "variant",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "std",
        "mod"
       ],
       "type": "string",
       "default": "std",
       "title": "Variant"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DesignRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "image/svg+xml": {}
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/design/report": {
   "post": {
    "summary": "Design Report",
    "description": "Informe del caso en HTML, PDF o XLSX.",
    "operationId": "design_report_design_report_post",
    "parameters": [
     {
      "name": "format",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "html",
        "pdf",
        "xlsx"
       ],
       "type": "string",
       "default": "html",
       "title": "Format"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DesignRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "text/html; charset=utf-8": {},
       "application/pdf": {},
       "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {}
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
