{
 "openapi": "3.1.0",
 "info": {
  "title": "trawlkit API",
  "description": "Diseño y dimensionamiento de redes de arrastre (motor trawlkit).",
  "version": "0.1.0"
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Health",
    "description": "Comprobación de vida.",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/catalog/nets": {
   "get": {
    "summary": "List Nets",
    "description": "Redes predefinidas.",
    "operationId": "list_nets_catalog_nets_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/CatalogItem"
         },
         "type": "array",
         "title": "Response List Nets Catalog Nets Get"
        }
       }
      }
     }
    }
   }
  },
  "/catalog/nets/{net_id}": {
   "get": {
    "summary": "Get Net",
    "description": "Especificación completa de una red predefinida (paneles, relingas, boyas).",
    "operationId": "get_net_catalog_nets__net_id__get",
    "parameters": [
     {
      "name": "net_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Net Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NetSpec"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/catalog/vessels": {
   "get": {
    "summary": "List Vessels",
    "description": "Buques del catálogo.",
    "operationId": "list_vessels_catalog_vessels_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Vessel"
         },
         "type": "array",
         "title": "Response List Vessels Catalog Vessels Get"
        }
       }
      }
     }
    }
   }
  },
  "/catalog/doors": {
   "get": {
    "summary": "List Doors",
    "description": "Portones del catálogo con su polar CL/CD.",
    "operationId": "list_doors_catalog_doors_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Door"
         },
         "type": "array",
         "title": "Response List Doors Catalog Doors Get"
        }
       }
      }
     }
    }
   }
  },
  "/params": {
   "get": {
    "summary": "List Params",
    "description": "Parámetros de diseño sobrescribibles en ``DesignRequest.params``.",
    "operationId": "list_params_params_get",
    "responses": {
     "200": {
      "description": "Successful Response",
